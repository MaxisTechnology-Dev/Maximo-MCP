# ══════════════════════════════════════════════════════════════════
# Maximo Enterprise MCP — Environment Variables
# Copy this file to .env and fill in your values.
# ══════════════════════════════════════════════════════════════════

# ── Deployment Environment ────────────────────────────────────────
# Free-form label stamped into every audit record and surfaced on
# /healthz so an operator can confirm a "dev" container is not
# pointed at the production Maximo. Recommended values: dev|staging|prod.
MAXIMO_ENV=dev

# ── Maximo Connection ─────────────────────────────────────────────
MAXIMO_URL=https://your-maximo-host.com/maximo/oslc
MAXIMO_HOST=https://your-maximo-host.com

# ── Authentication Mode ───────────────────────────────────────────
# Options: basic | apikey | oauth
# Use "basic" if you have a Maximo username and password (most common)
AUTH_MODE=basic

# Basic Auth (username + password) — used when AUTH_MODE=basic
MAXIMO_USERNAME=your-maximo-username
MAXIMO_PASSWORD=your-maximo-password

# API Key Auth — used when AUTH_MODE=apikey
# MAXIMO_API_KEY=your-api-key-here

# OAuth 2.0 — used when AUTH_MODE=oauth
# OAUTH_TOKEN_URL=https://your-auth-server.com/oauth/token
# OAUTH_CLIENT_ID=your-client-id
# OAUTH_CLIENT_SECRET=your-client-secret

# ── Redis Cache (optional but recommended) ────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
CACHE_TTL_SECONDS=300
CACHE_ENABLED=true

# ── MCP Transport ─────────────────────────────────────────────────
# stdio: use with Claude Desktop, Cursor, VS Code (most common)
# http:  use for Docker/server deployments
TRANSPORT_MODE=stdio
HTTP_PORT=8080
HTTP_HOST=0.0.0.0
# Required for hosted HTTP/SSE mode (when MCP_AUTH_MODE includes "static").
# Leave blank for local stdio-only usage.
MCP_ACCESS_TOKEN=

# ── Inbound Auth Mode (hosted HTTP only) ──────────────────────────
# static — Authorization: Bearer <MCP_ACCESS_TOKEN>; identity from
#          X-MCP-User-Id / X-MCP-Tenant-Id / X-MCP-Role headers
#          (typically injected by an upstream gateway)
# jwt    — Authorization: Bearer <JWT>; validated against OIDC_ISSUER
#          + OIDC_AUDIENCE; identity from JWT claims
# both   — Try JWT first, fall back to static (useful for ops/CI)
MCP_AUTH_MODE=static

# Required when MCP_AUTH_MODE is "jwt" or "both"
# OIDC_ISSUER=https://your-tenant.auth0.com/
# OIDC_AUDIENCE=https://maximo-mcp.example.com
# OIDC_JWKS_URL=                                  # auto-derived from issuer if blank
# OIDC_ALGORITHMS=["RS256"]
# OIDC_JWKS_CACHE_TTL_SECONDS=3600
# OIDC_USER_CLAIM=sub                             # claim → Identity.user_id
# OIDC_ROLE_CLAIM=role                            # claim → Identity.role (string OR list)
# OIDC_TENANT_CLAIM=tenant                        # claim → Identity.tenant_id

# ── AI Features (optional) ────────────────────────────────────────
# Required for nl_to_oslc_query LLM enhancement and suggest_root_cause
# Leave empty to use pattern-based fallback (still works without it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Sentence transformer model for RAG/knowledge search
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./chroma_db

# ── Security & RBAC ───────────────────────────────────────────────
RBAC_ENABLED=true

# Role for the current session (used for RBAC enforcement)
# Options: readonly | technician | supervisor | manager | admin
CURRENT_USER_ROLE=readonly
CURRENT_USER_ID=system

# ── CORS (HTTP/SSE only) ──────────────────────────────────────────
# Browser-based MCP clients require CORS. Default is empty allowlist =
# no cross-origin requests accepted. Add explicit origins per environment.
# Pydantic accepts JSON-array syntax for List[str] env vars.
# MCP_ALLOWED_ORIGINS=["https://app.example.com","https://staging.example.com"]
MCP_ALLOWED_ORIGINS=[]
MCP_CORS_ALLOW_CREDENTIALS=false
# Wildcard "*" is rejected when MCP_CORS_ALLOW_CREDENTIALS=true.

# ── Tool Discovery (HTTP/SSE only) ────────────────────────────────
# When false, /v1/tools and /v1/providers/* return 404. Recommended
# OFF in production unless paired with per-caller OIDC tokens (G6),
# so a leaked bearer token cannot enumerate the full tool surface.
MCP_DISCOVERY_ENABLED=true

# ── In-process TLS (HTTP/SSE only) ────────────────────────────────
# Optional. If both are set, uvicorn binds with TLS instead of plaintext.
# Recommended path is TLS at the edge (ALB / Front Door / API Gateway);
# in-process TLS is for single-tenant operators without an edge proxy.
# MCP_SSL_CERTFILE=/etc/ssl/certs/maximo-mcp.crt
# MCP_SSL_KEYFILE=/etc/ssl/private/maximo-mcp.key

# ── Output PII Masking ────────────────────────────────────────────
# Mask person-data fields (email, phone, SSN, salary, etc.) in Maximo
# responses before they leave the server. Default field list lives in
# core/pii.py; PII_MASK_FIELDS appends extra leaf field names (one per
# comma-separated entry, case-insensitive).
PII_MASK_ENABLED=true
# PII_MASK_FIELDS=["customfield1","customfield2"]
PII_MASK_VALUE=***MASKED***

# ── Audit Logging ─────────────────────────────────────────────────
# Persistence destination — see core/audit_sinks.py for the interface.
#   file   — JSONL on local disk with size-based rotation (default).
#   stdout — JSONL to stdout; cloud runtime / sidecar ships to SIEM.
#   both   — write to file AND stdout (migration window).
AUDIT_SINK=file
AUDIT_LOG_FILE=./logs/audit.jsonl
AUDIT_FILE_MAX_BYTES=50000000
AUDIT_FILE_BACKUP_COUNT=5
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── HTTP Client ───────────────────────────────────────────────────
# Large work-order / OSLC queries may need 90s+ on busy Maximo instances.
HTTP_TIMEOUT_SECONDS=90
HTTP_CONNECT_TIMEOUT_SECONDS=3
HTTP_READ_TIMEOUT_SECONDS=90
HTTP_WRITE_TIMEOUT_SECONDS=60
HTTP_POOL_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF_BASE_SECONDS=0.8
HTTP_RETRY_BACKOFF_MAX_SECONDS=15
HTTP_MAX_CONNECTIONS=50
HTTP_MAX_KEEPALIVE_CONNECTIONS=0
HTTP_KEEPALIVE_EXPIRY_SECONDS=10
DEBUG_HTTP=false

# ── Safe Defaults For Large Maximo Instances ──────────────────────
VPN_SAFE_MODE=true
DEFAULT_PAGE_SIZE=20
